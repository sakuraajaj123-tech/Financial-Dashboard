# Meta WhatsApp Cloud API Configuration
# Add these in Netlify Site configuration -> Environment variables (or local .env)

WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id_from_meta"
WHATSAPP_ACCESS_TOKEN="your_system_user_permanent_access_token"
META_PHONE_NUMBER_ID="your_phone_number_id_from_meta"
META_ACCESS_TOKEN="your_system_user_permanent_access_token"
META_VERIFY_TOKEN="your_custom_webhook_verify_token"

# Admin Forwarding & Notifications Configuration
ADMIN_PHONE_NUMBER="9665XXXXXXXX"
ADMIN_ALERT_TEMPLATE_NAME="admin_guest_notification"
ADMIN_ALERT_TEMPLATE_LANG="ar"

# Optional: set to 'true' if testing live API locally with 'netlify dev'
VITE_USE_LIVE_API="false"

# Firebase Client SDK
# Option A (Single variable containing JSON string):
VITE_FIREBASE_KEYS='{"apiKey":"your_key","authDomain":"your_project.firebaseapp.com","projectId":"your_project_id","storageBucket":"your_project.appspot.com","messagingSenderId":"123456","appId":"1:123456:web:abc"}'

# Option B (Individual variables):
# VITE_FIREBASE_API_KEY="your_firebase_api_key"
# VITE_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your_project_id"
# VITE_FIREBASE_STORAGE_BUCKET="your_project.appspot.com"
# VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
# VITE_FIREBASE_APP_ID="1:123456789:web:abc123"


