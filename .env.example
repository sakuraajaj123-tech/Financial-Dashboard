# Meta WhatsApp Cloud API Configuration
# Add these in Netlify Site configuration -> Environment variables (or local .env)

WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id_from_meta"
WHATSAPP_ACCESS_TOKEN="your_system_user_permanent_access_token"
META_PHONE_NUMBER_ID="your_phone_number_id_from_meta"
META_ACCESS_TOKEN="your_system_user_permanent_access_token"
META_VERIFY_TOKEN="your_custom_webhook_verify_token"

# ── Admin WhatsApp Notification System ──────────────────────────────────────
# Sends a real-time WhatsApp alert to the admin whenever a guest sends a message.
#
# HOW THE 24-HOUR WINDOW WORKS:
#   The window is tracked based on when the ADMIN last messaged the business number —
#   NOT based on the guest's activity. Every time the admin writes to the business
#   WhatsApp number, the system records the timestamp in Firestore (adminLastInboundAt).
#
#   If (now - adminLastInboundAt) <= 24h  →  Option 1: Free-form text (no cost)
#   If (now - adminLastInboundAt) >  24h  →  Option 2: Approved Meta template
#
# ADMIN_PHONE_NUMBER:
#   The phone number that receives notifications. Use international format, digits only.
#   Example: 9665XXXXXXXX  (Saudi Arabia +966, no + sign, no spaces)
ADMIN_PHONE_NUMBER="9665XXXXXXXX"

# ADMIN_ALERT_TEMPLATE_NAME:
#   The exact name of your Meta-approved WhatsApp template used when the 24h window
#   with the admin is closed. Must be approved in Meta Business Manager.
#   Template must have 3 body variables: {{1}} = Name, {{2}} = Phone, {{3}} = Message
ADMIN_ALERT_TEMPLATE_NAME="admin_guest_notification"

# ADMIN_ALERT_TEMPLATE_LANG:
#   Language code of the approved template. Must match exactly what Meta has on record.
#   Common values: ar, ar_SA, en, en_US
ADMIN_ALERT_TEMPLATE_LANG="ar"


# Optional: set to 'true' if testing live API locally with 'netlify dev'
VITE_USE_LIVE_API="false"

# Firebase Client SDK
# Option A (Single variable containing JSON string):
VITE_FIREBASE_KEYS='{"apiKey":"your_key","authDomain":"your_project.firebaseapp.com","projectId":"your_project_id","storageBucket":"your_project.appspot.com","messagingSenderId":"123456","appId":"1:123456:web:abc"}'

# Option B (Individual variables):
# VITE_FIREBASE_API_KEY="your_firebase_api_key"
# VITE_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your_project_id"
# VITE_FIREBASE_STORAGE_BUCKET="your_project.appspot.com"
# VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
# VITE_FIREBASE_APP_ID="1:123456789:web:abc123"


